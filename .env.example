# ╔══════════════════════════════════════════════════════════════════╗
# ║  Venture YSWS — Environment Variables Template                  ║
# ║  Copy this file to .env and fill in the values.                 ║
# ║  NEVER commit your actual .env file.                            ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection string. For local dev, use the Docker Compose defaults.
DATABASE_URL=YOUR_DATABASE_CONNECTION_STRING

# ── Session & Security ────────────────────────────────────────────
# Secret key for signing session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-something-random
# PLATFORM_PASSWORD=              # Optional: gate the platform behind a password
# JOURNALING_PW=                  # Optional: protect journal review page
# JOURNALING_LINK_SECRET=         # Optional: secret for signed journal share links (falls back to SESSION_SECRET)
# AIRTABLE_SYNC_SECRET=           # Optional: secret header for external Airtable sync trigger
# CDN_API_KEY=                    # Optional: Hack Club CDN Bearer token for image uploads

# ── Roles ─────────────────────────────────────────────────────────
# Comma-separated list of emails that get superadmin access.
SUPERADMIN_EMAILS=admin@example.com
# ADMIN_EMAILS=                   # Comma-separated list of admin-level emails
# REVIEWERS_EMAILS=               # Comma-separated list of reviewer-level emails

# ── Hack Club Auth (OAuth) ────────────────────────────────────────
# Create an app at https://auth.hackclub.com/developer/apps
# Callback URL: http://localhost:3001/api/auth/hackclub/callback
HC_CLIENT_ID=
HC_CLIENT_SECRET=
# HC_REDIRECT_URI=                # Optional: explicit callback URI override
# HC_SCOPES=                      # Optional: override default scopes (openid email name profile slack_id etc.)
# OAUTH_ALLOWED_REDIRECT_URIS=    # Optional: comma-separated allowlist of redirect URIs

# ── Hackatime Auth (OAuth) ────────────────────────────────────────
# Create an app at https://hackatime.hackclub.com/oauth/applications
# Scopes: profile, read. Confidential: Yes.
# Callback URL: http://localhost:3001/api/auth/hackatime/callback
HACKATIME_UID=
HACKATIME_SECRET=

# ── Airtable ──────────────────────────────────────────────────────
# Create a Personal Access Token at https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write
# Base ID starts with "app...", Table IDs start with "tbl..."
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_USERS_TABLE_ID=
AIRTABLE_PROJECTS_TABLE_ID=
AIRTABLE_ORDERS_TABLE_ID=
AIRTABLE_JOURNALS_TABLE_ID=
AIRTABLE_SIGNUPS_TABLE_ID=
# AIRTABLE_SYNC_INTERVAL_MS=     # Optional: override periodic sync interval

# ── Airtable YSWS (Unified submission sync) ───────────────────────
# These are provided by HC staff when your YSWS is officially approved.
# AIRTABLE_YSWS_BASE_ID=
# AIRTABLE_YSWS_PROJECT_SUBMISSION_TABLE_ID=
# AIRTABLE_YSWS_PROJECT_SUBMISSION_TABLE_NAME=
# AIRTABLE_YSWS_TABLE_NAME=
# AIRTABLE_YSWS_STATUS_FIELD_ID=
# AIRTABLE_YSWS_STATUS_FIELD_NAME=
# AIRTABLE_YSWS_UPDATE_FIELD_ID=
# AIRTABLE_YSWS_USE_FIELD_NAMES=

# ── Server ────────────────────────────────────────────────────────
# PORT=3001                       # Server port (default: 3001)
# HOST=0.0.0.0                    # Bind address
# APP_ORIGIN=                     # Production origin (e.g. https://venture.hackclub.com)
# NODE_ENV=development            # Set to "production" in production
# VITE_DEV_PORT=5174              # Vite dev server port
# PGSSLMODE=                      # PostgreSQL SSL mode (e.g. "require" for production)

# ── Dev Overrides ─────────────────────────────────────────────────
# DEV_USER_EMAIL=                 # Override auto-login email in local dev
# DEV_AUTH_COOKIE_SECRET=         # Override cookie signing secret in dev
# RECREATE_USERS_TABLE=           # Set to "true" to wipe and rebuild users table on boot (DANGEROUS)
